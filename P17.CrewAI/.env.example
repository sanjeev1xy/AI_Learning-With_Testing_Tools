APP_NAME=Jira QA Crew
APP_ENV=development
OUTPUT_DIR=outputs

# ---- LLM (required for CrewAI) --------------------------------------------
# Model id is NOT hard-coded anywhere; set it here. Any LiteLLM-supported id.
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000

# ---- Jira integration ----------------------------------------------------
JIRA_INTEGRATION_MODE=auto            # auto | mcp | rest
JIRA_URL=https://your-domain.atlassian.net
JIRA_AUTH_MODE=basic                  # basic | bearer
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BEARER_TOKEN=
JIRA_API_VERSION=3
JIRA_ACCEPTANCE_CRITERIA_FIELD=       # e.g. customfield_10101
JIRA_INCLUDE_COMMENTS=false
JIRA_MAX_COMMENTS=20

# ---- Jira MCP (primary provider) ---------------------------------------
JIRA_MCP_TRANSPORT=streamable_http    # streamable_http | stdio
JIRA_MCP_URL=
JIRA_MCP_COMMAND=
JIRA_MCP_ARGS_JSON=[]
JIRA_MCP_HEADERS_JSON={}
JIRA_MCP_GET_ISSUE_TOOL=              # override tool name if auto-detect fails
JIRA_MCP_TIMEOUT_SECONDS=20

# ---- Pipeline ---------------------------------------------------------
PIPELINE_MAX_TICKETS=20
PIPELINE_MAX_RETRIES=2
PIPELINE_MAX_RPM=3  # crew LLM calls/min; keep low for Groq free-tier 8000 TPM
PIPELINE_TICKET_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO

# ---- Demo mode ------------------------------------------------------
# Only used when true AND no live Jira provider is configured. Never an
# automatic fallback for a failed live integration.
# Explicit switch: true = always fixtures (UI works offline); false = always live
# Jira (a live failure errors out; demo data is never a silent fallback).
DEMO_MODE=false
# In DEMO MODE, when no fixture matches a ticket key, synthesize a clearly
# labelled placeholder ticket so the pipeline still runs. Never live data.
DEMO_ALLOW_SYNTHETIC=true
