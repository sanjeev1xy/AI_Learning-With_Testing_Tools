# Copy to .streamlit/secrets.toml for Streamlit Community Cloud.
# These are read via os.environ by the app's config loader, so the same names
# as .env work. NEVER commit the real secrets.toml.

LLM_MODEL = "openai/gpt-oss-120b"
LLM_API_KEY = "your-llm-api-key"
LLM_BASE_URL = "https://api.groq.com/openai/v1"

JIRA_INTEGRATION_MODE = "auto"
JIRA_URL = "https://your-domain.atlassian.net"
JIRA_EMAIL = "you@example.com"
JIRA_API_TOKEN = "your-atlassian-api-token"
JIRA_ACCEPTANCE_CRITERIA_FIELD = "customfield_10101"

JIRA_MCP_URL = ""
JIRA_MCP_GET_ISSUE_TOOL = ""

DEMO_MODE = "false"
